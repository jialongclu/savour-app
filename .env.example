# Copy to .env and fill in. Restart with `npx expo start --clear` after changing.

# ---------------------------------------------------------------------------
# and no migrations — sign-in becomes a button, data lives in memory. Nothing
# below matters while this is on. Delete the line to use a real backend.
# ---------------------------------------------------------------------------

# EXPO_PUBLIC_* values are embedded in the app bundle — never put a service_role
# key or any other secret here. The anon key is safe because RLS is what actually
# protects the data (see supabase/migrations).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog. These public values are embedded in the app bundle at build time.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google sign-in. Create OAuth client IDs in Google Cloud Console
# (APIs & Services → Credentials) and add the Web client to Supabase
# Authentication → Providers → Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat. Project settings -> API keys -> the public *SDK* key for each
# platform (starts appl_ / goog_). Safe to ship: they only identify the app.
# Leave blank to run without billing — the paywall then never gates.
# One key for both platforms, from RevenueCat's Test Store. The store keys
# below take precedence once real products exist.
EXPO_PUBLIC_RC_KEY=

EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
