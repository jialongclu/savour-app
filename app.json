{
  "expo": {
    "name": "Savour",
    "slug": "savour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "savour",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jialonglu.savour",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Savour uses the camera to shoot frames into your rolls.",
        "NSPhotoLibraryUsageDescription": "Savour needs access to your photos so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Savour saves the photographs from a developed roll into your library."
      }
    },
    "android": {
      "package": "com.savour.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Savour uses the camera to shoot frames into your rolls."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Savour needs access to your photos so you can choose a profile picture.",
          "savePhotosPermission": "Savour saves the photographs from a developed roll into your library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf8ea238-ced8-4af6-ab85-08d28646b448"
      }
    },
    "owner": "jialonglu1s-team"
  }
}
